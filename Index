        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline" data-close-modal="goal-modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar meta</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: Guardar valor na meta -->
  <div id="deposit-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="deposit-modal-title">
    <div class="modal-card modal-card-sm">
      <div class="modal-header">
        <h2 id="deposit-modal-title" class="modal-title">Guardar no cofrinho</h2>
        <button class="icon-btn close-modal-btn" data-close-modal="deposit-modal" type="button" aria-label="Fechar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <form id="deposit-form" class="modal-form">
        <input type="hidden" id="deposit-goal-id" />
        <p id="deposit-goal-name" class="modal-helper"></p>
        <div class="form-group">
          <label for="deposit-amount">Valor a guardar (R$)</label>
          <input id="deposit-amount" type="number" step="0.01" min="0.01" placeholder="100,00" required />
        </div>
        <div class="quick-amounts">
          <button type="button" class="chip-btn" data-quick-deposit="50">+ R$ 50</button>
          <button type="button" class="chip-btn" data-quick-deposit="100">+ R$ 100</button>
          <button type="button" class="chip-btn" data-quick-deposit="250">+ R$ 250</button>
          <button type="button" class="chip-btn" data-quick-deposit="500">+ R$ 500</button>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" data-close-modal="deposit-modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar dinheiro</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: Definir limite mensal -->
  <div id="budget-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="budget-modal-title">
    <div class="modal-card modal-card-sm">
      <div class="modal-header">
        <h2 id="budget-modal-title" class="modal-title">Limite geral do mês</h2>
        <button class="icon-btn close-modal-btn" data-close-modal="budget-modal" type="button" aria-label="Fechar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <form id="budget-form" class="modal-form">
        <p class="modal-helper">Escolha o valor máximo total (avulsos + contas + parcelas) que você pretende gastar por mês.</p>
        <div class="form-group">
          <label for="budget-input">Limite mensal (R$)</label>
          <input id="budget-input" type="number" step="1" min="0" placeholder="3800" required />
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline" data-close-modal="budget-modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Salvar limite</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL: Dados, Backup & Ajuda -->
  <div id="data-modal" class="modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="data-modal-title">
    <div class="modal-card">
      <div class="modal-header">
        <h2 id="data-modal-title" class="modal-title">Backup e Configurações</h2>
        <button class="icon-btn close-modal-btn" data-close-modal="data-modal" type="button" aria-label="Fechar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      <div class="settings-list">
        <div class="settings-item">
          <div>
            <strong>Como funciona?</strong>
            <p>Seus lançamentos, contas, parcelas, tetos e metas ficam salvos automaticamente neste navegador.</p>
          </div>
        </div>

        <div class="settings-item">
          <div>
            <strong>Exportar planilha (CSV)</strong>
            <p>Baixe todos os lançamentos para abrir no Excel ou Google Planilhas.</p>
          </div>
          <button id="export-csv-btn" class="btn btn-sm btn-outline" type="button">Baixar CSV</button>
        </div>

        <div class="settings-item">
          <div>
            <strong>Fazer backup completo (JSON)</strong>
            <p>Salve uma cópia de segurança para restaurar em outro computador.</p>
          </div>
          <button id="export-json-btn" class="btn btn-sm btn-outline" type="button">Salvar backup</button>
        </div>

        <div class="settings-item">
          <div>
            <strong>Restaurar backup</strong>
            <p>Carregue um arquivo .json salvo anteriormente.</p>
          </div>
          <label class="btn btn-sm btn-outline file-btn">
            Escolher arquivo
            <input id="import-json-input" type="file" accept=".json,application/json" hidden />
          </label>
        </div>

        <div class="settings-item settings-item-danger">
          <div>
            <strong>Dados de exemplo ou limpar tudo</strong>
            <p>Restaure o exemplo inicial para testar ou apague todos os dados para começar do zero.</p>
          </div>
          <div class="settings-btn-group">
            <button id="load-demo-btn" class="btn btn-sm btn-outline" type="button">Carregar exemplo</button>
            <button id="wipe-all-btn" class="btn btn-sm btn-danger-soft" type="button">Apagar tudo</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Toast de feedback / desfazer -->
  <div id="toast-container" class="toast-container" aria-live="polite"></div>

  <script src="app.js"></script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- No frame may navigate anywhere: blocks the narrator frame from
       navigating itself (its srcdoc load is exempt). See app.js. -->
  <meta http-equiv="Content-Security-Policy" content="frame-src 'none'; child-src 'none'">
  <title>Swarm</title>
  <script src="/preload.js"></script>
  <!-- Google Sans Flex (the Hub's UI face, same axes as the Hub) and Google Sans Code. -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" media="print" onload="this.media='all'" href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:ROND,opsz,slnt,wdth,wght@0..100,6..144,-10..0,92..100,100..1000&family=Google+Sans+Code:ital,wght@0,300..800;1,300..800&display=swap">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/hive.css">
</head>
<body>
  <!-- Loading: a skeleton of the board, so the pane never flashes empty. -->
  <div id="loading" class="loading" data-testid="swarm-loading" aria-live="polite" aria-busy="true">
    <div class="skel-header">
      <span class="skel skel-line" style="width: 46%; height: 12px"></span>
      <span class="skel skel-line" style="width: 28%"></span>
    </div>
    <div class="skel-tabs">
      <span class="skel skel-tab"></span><span class="skel skel-tab"></span><span class="skel skel-tab"></span><span class="skel skel-tab"></span>
    </div>
    <div class="skel-rows" aria-hidden="true">
      <div class="skel-stack"><span class="skel skel-line" style="width: 22%"></span><span class="skel skel-line" style="width: 88%"></span><span class="skel skel-line" style="width: 62%"></span></div>
      <div class="skel-stack"><span class="skel skel-line" style="width: 18%"></span><span class="skel skel-line" style="width: 74%"></span></div>
      <div class="skel-stack"><span class="skel skel-line" style="width: 26%"></span><span class="skel skel-line" style="width: 92%"></span><span class="skel skel-line" style="width: 48%"></span></div>
    </div>
    <p class="loading-caption">Looking for this conversation's swarm…</p>
  </div>

  <div id="board" class="board hidden" data-testid="swarm-board">
    <header class="header">
      <div class="header-row">
        <h1 id="swarm-title" class="swarm-title" data-testid="swarm-title"></h1>
        <span id="live" class="live" role="status" title="Updates automatically" data-testid="swarm-live">
          <span class="live-dot" aria-hidden="true"></span><span id="live-label" class="live-label">Live</span>
        </span>
      </div>
      <div id="swarm-meta" class="meta hidden" data-testid="swarm-meta"></div>
      <nav class="tabs" role="tablist" aria-label="Swarm views" data-testid="swarm-tabs">
        <button type="button" role="tab" id="tabbtn-overview" aria-controls="tab-overview" aria-selected="false" tabindex="-1" data-tab="overview" class="tab hidden" data-testid="swarm-tab-overview">Overview<span id="tab-badge-overview" class="tab-badge hidden" data-testid="swarm-tab-badge-overview"></span></button>
        <button type="button" role="tab" id="tabbtn-feed" aria-controls="tab-feed" aria-selected="true" data-tab="feed" class="tab active" data-testid="swarm-tab-feed">Board<span id="tab-count-feed" class="tab-count" data-testid="swarm-tab-count-feed"></span></button>
        <button type="button" role="tab" id="tabbtn-members" aria-controls="tab-members" aria-selected="false" tabindex="-1" data-tab="members" class="tab" data-testid="swarm-tab-members">Members<span id="tab-count-members" class="tab-count" data-testid="swarm-tab-count-members"></span></button>
        <button type="button" role="tab" id="tabbtn-graph" aria-controls="tab-graph" aria-selected="false" tabindex="-1" data-tab="graph" class="tab hidden" data-testid="swarm-tab-graph">Graph</button>
        <button type="button" role="tab" id="tabbtn-raw" aria-controls="tab-raw" aria-selected="false" tabindex="-1" data-tab="raw" class="tab hidden" data-testid="swarm-tab-raw">Raw</button>
      </nav>
    </header>

    <main class="main">
      <!-- Overview: chrome (trusted, rendered by app.js) around the narrator's
           view, which runs in a sandboxed frame or as the plain view. Hidden
           (tab and all) until the swarm has a view.json or view.html. -->
      <section id="tab-overview" class="tab-body" role="tabpanel" aria-labelledby="tabbtn-overview" data-testid="swarm-overview">
        <div id="ov-status" class="ov-status" data-testid="swarm-overview-status"></div>
        <div id="ov-system" class="ov-system hidden" role="list" aria-label="System alerts" data-testid="swarm-overview-system"></div>
        <div id="ov-notice" class="ov-notice hidden" role="status" data-testid="swarm-overview-notice"></div>
        <div id="ov-label" class="ov-label hidden" data-testid="swarm-overview-label">
          <span class="ov-label-text">overview · from the narrator’s notes</span>
          <span class="spacer"></span>
          <button id="ov-mode" type="button" class="ghost-btn sm" aria-pressed="false" data-testid="swarm-overview-mode">Narrator’s page</button>
        </div>
        <div id="ov-frame" class="ov-frame hidden" data-testid="swarm-overview-frame"></div>
        <div id="ov-plain" class="ov-plain hidden" data-testid="swarm-overview-plain"></div>
        <footer id="ov-footer" class="ov-footer hidden" data-testid="swarm-overview-footer">
          <div class="ov-hint">
            <span aria-hidden="true">💡</span>
            <span>Want this view different? Tell the coordinator.</span>
            <button id="ov-open-coord" type="button" class="link-btn" data-testid="swarm-overview-open-coordinator">Open coordinator chat</button>
          </div>
          <div id="ov-ack" class="ov-ack hidden" data-testid="swarm-overview-ack"></div>
        </footer>
      </section>

      <!-- Board -->
      <section id="tab-feed" class="tab-body active" role="tabpanel" aria-labelledby="tabbtn-feed">
        <div class="toolbar">
          <div class="searchbar">
            <label class="search">
              <svg class="icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.25"/><path d="m10.25 10.25 3.25 3.25"/></svg>
              <input id="f-search" type="search" placeholder="Search" aria-label="Search posts" autocomplete="off" data-testid="swarm-search">
            </label>
            <button id="f-toggle" type="button" class="icon-btn filter-toggle" aria-expanded="false" aria-controls="filters" title="Filters" aria-label="Filters" data-testid="swarm-filter-toggle">
              <svg class="icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 4.5h11M4.5 8h7M6.5 11.5h3"/></svg>
              <span class="filter-dot" aria-hidden="true"></span>
            </button>
          </div>
          <!-- Channels: shown only once the swarm has a non-main channel. -->
          <div id="channel-tabs" class="channel-tabs hidden" role="tablist" aria-label="Channels" data-testid="swarm-channel-tabs"></div>
          <div id="filters" class="filters hidden" data-testid="swarm-filters">
            <div class="toolbar-row">
              <span class="select"><select id="f-agent" aria-label="Filter by poster" title="Show posts by one member"><option value="">From anyone</option></select></span>
              <span class="select"><select id="f-mention" aria-label="Filter by recipient" title="Show posts that call on one member"><option value="">To anyone</option></select></span>
              <span id="f-channel-wrap" class="select hidden"><select id="f-channel" aria-label="Filter by channel" title="Show posts in one channel" data-testid="swarm-channel-filter"><option value="">All channels</option></select></span>
              <span class="spacer"></span>
              <label class="switch" title="Keep the newest post in view">
                <input type="checkbox" id="f-autoscroll" checked><span class="switch-track" aria-hidden="true"></span><span>Follow</span>
              </label>
            </div>
            <div id="agents" class="agents" data-testid="swarm-agents" role="group" aria-label="Show or hide each member's posts"></div>
          </div>
        </div>
        <div id="feed" class="feed" data-testid="swarm-feed" aria-live="polite" aria-relevant="additions"></div>
        <button id="jump-latest" type="button" class="jump hidden" data-testid="swarm-jump-latest">
          <svg class="icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v9.5M4 9l4 4 4-4"/></svg>Latest
        </button>
      </section>

      <!-- Members -->
      <section id="tab-members" class="tab-body" role="tabpanel" aria-labelledby="tabbtn-members">
        <div id="members" class="members" data-testid="swarm-members" role="list"></div>
      </section>

      <!-- Graph -->
      <section id="tab-graph" class="tab-body" role="tabpanel" aria-labelledby="tabbtn-graph">
        <div class="player">
          <div class="player-row">
            <div class="btn-group" role="group" aria-label="Replay">
              <button id="replay-start" type="button" class="icon-btn" title="Jump to start" aria-label="Jump to start">
                <svg class="icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 3.5v9"/><path class="fill" d="M12.5 3.8v8.4a.4.4 0 0 1-.62.33L6.3 8.33a.4.4 0 0 1 0-.66l5.58-4.2a.4.4 0 0 1 .62.33z"/></svg>
              </button>
              <button id="replay-back" type="button" class="icon-btn" title="Previous post (←)" aria-label="Previous post">
                <svg class="icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5"/></svg>
              </button>
              <button id="replay-play" type="button" class="icon-btn play" title="Play / pause replay (space)" aria-label="Play replay" data-testid="swarm-replay-play"></button>
              <button id="replay-fwd" type="button" class="icon-btn" title="Next post (→)" aria-label="Next post">
                <svg class="icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5 10.5 8 6 12.5"/></svg>
              </button>
            </div>
            <input id="replay-slider" class="slider" type="range" min="0" max="0" value="0" aria-label="Replay position" title="Scrub through board posts">
            <button id="replay-live" type="button" class="pill-btn on" title="Show everything and follow live" aria-pressed="true"><span class="live-dot" aria-hidden="true"></span>Live</button>
          </div>
          <div class="player-row sub">
            <span id="replay-label" class="replay-label"></span>
            <span class="spacer"></span>
            <div class="segmented" role="group" aria-label="Graph view">
              <button type="button" id="gview-hive" data-gview="hive" class="gview-btn on" aria-pressed="true" title="Threads as cells, with each worker where it works">Hive</button>
              <button type="button" id="gview-mentions" data-gview="mentions" class="gview-btn" aria-pressed="false" title="Who @mentions whom">Mentions</button>
            </div>
            <label class="switch" title="Hide killed and inactive members from the graph">
              <input type="checkbox" id="g-hide-inactive" data-testid="swarm-graph-hide-inactive"><span class="switch-track" aria-hidden="true"></span><span>Hide inactive</span>
            </label>
            <label class="switch" title="Draw @all as an edge to every member">
              <input type="checkbox" id="g-all"><span class="switch-track" aria-hidden="true"></span><span>Expand @all</span>
            </label>
            <span class="select sm"><select id="replay-timing" aria-label="Replay pacing" title="Replay pacing">
              <option value="even">Even pacing</option>
              <option value="real">Real-time gaps</option>
            </select></span>
            <span class="select sm"><select id="replay-speed" aria-label="Replay speed" title="Replay speed">
              <option value="0.5">0.5×</option>
              <option value="1" selected>1×</option>
              <option value="2">2×</option>
              <option value="4">4×</option>
              <option value="8">8×</option>
            </select></span>
            <button id="graph-export-gif" type="button" class="ghost-btn sm export-gif-btn" title="Export graph replay as an animated GIF" data-testid="swarm-graph-export-gif">
              <svg class="icon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v7.5M5 7.5 8 10.5l3-3"/><path d="M3 12.5h10"/></svg><span id="graph-export-gif-label">Export GIF</span>
            </button>
          </div>
        </div>
        <div id="hive" data-testid="swarm-hive"></div>
        <svg id="graph" class="graph" data-testid="swarm-graph" preserveAspectRatio="xMidYMin meet" role="img" aria-label="Who @mentions whom"></svg>
        <div class="graph-legend" aria-hidden="true">
          <span class="legend-item"><svg width="22" height="8" viewBox="0 0 24 8"><path d="M1 4h18" class="lg-solid"/><path d="M17 1l5 3-5 3z" class="lg-head"/></svg>@mention, width = count</span>
          <span class="legend-item"><svg width="22" height="8" viewBox="0 0 24 8"><path d="M1 4h18" class="lg-dash"/><path d="M17 1l5 3-5 3z" class="lg-head"/></svg>via @all</span>
          <span class="legend-item"><svg width="16" height="10" viewBox="0 0 16 10"><rect x="1" y="1" width="14" height="8" rx="4" class="lg-ring"/></svg>posted with no mention</span>
          <span class="legend-item"><span class="lg-bcast">@all 2</span>@all posts, drawn by Expand @all</span>
        </div>
        <div id="replay-caption" class="msg replay-caption hidden" aria-live="polite"></div>
      </section>

      <!-- Raw -->
      <section id="tab-raw" class="tab-body" role="tabpanel" aria-labelledby="tabbtn-raw">
        <div class="raw-toolbar">
          <div class="segmented" role="group" aria-label="File">
            <button type="button" data-raw="members" class="raw-btn on" aria-pressed="true">members.json</button>
            <button type="button" data-raw="board" class="raw-btn" aria-pressed="false">board.jsonl</button>
            <button type="button" id="raw-btn-view" data-raw="view" class="raw-btn hidden" aria-pressed="false">view.json</button>
          </div>
          <span class="spacer"></span>
          <button id="raw-copy" type="button" class="ghost-btn" title="Copy to clipboard" data-testid="swarm-raw-copy">
            <svg class="icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path d="M10.5 5.5v-1.5a1.5 1.5 0 0 0-1.5-1.5H4a1.5 1.5 0 0 0-1.5 1.5v5A1.5 1.5 0 0 0 4 10.5h1.5"/></svg><span id="raw-copy-label">Copy</span>
          </button>
        </div>
        <div id="raw-meta" class="raw-meta"></div>
        <pre id="raw" class="raw" data-testid="swarm-raw" tabindex="0"></pre>
      </section>
    </main>
  </div>

  <section id="empty" class="empty hidden" data-testid="swarm-empty-state" aria-labelledby="empty-title">
    <div class="empty-card">
      <svg class="empty-icon" width="56" height="56" viewBox="0 0 96 96" aria-hidden="true">
        <g class="links">
          <line x1="48" y1="26" x2="25" y2="66"/>
          <line x1="48" y1="26" x2="71" y2="66"/>
          <line x1="25" y1="66" x2="71" y2="66"/>
        </g>
        <circle class="node" cx="48" cy="26" r="9"/>
        <circle class="node" cx="25" cy="66" r="8"/>
        <circle class="node" cx="71" cy="66" r="8"/>
      </svg>
      <h2 id="empty-title" class="empty-title" data-testid="swarm-empty-title">No swarm in this conversation</h2>
      <p id="empty-body" class="empty-body" data-testid="swarm-empty-body"></p>
      <p class="empty-hint"><span class="live-dot" aria-hidden="true"></span>Watching for a swarm</p>
    </div>
  </section>

  <div id="gif-modal" class="gif-modal hidden" role="dialog" aria-modal="true" aria-labelledby="gif-modal-title" data-testid="swarm-gif-modal">
    <div class="gif-modal-card">
      <div class="gif-modal-head">
        <div class="gif-modal-titles">
          <div id="gif-modal-title" class="gif-modal-title"></div>
          <div id="gif-modal-meta" class="gif-modal-meta"></div>
        </div>
        <button id="gif-modal-close" type="button" class="icon-btn" aria-label="Close preview" title="Close" data-testid="swarm-gif-modal-close">
          <svg class="icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8"/></svg>
        </button>
      </div>
      <div class="gif-modal-body">
        <img id="gif-modal-img" class="gif-modal-img" alt="Exported swarm graph replay" data-testid="swarm-gif-modal-img">
      </div>
      <div class="gif-modal-foot">
        <span class="gif-modal-hint">Right-click image to save, or open in a new tab.</span>
        <span class="spacer"></span>
        <a id="gif-modal-open" class="ghost-btn sm" target="_blank" rel="noopener" data-testid="swarm-gif-modal-open">Open in new tab</a>
      </div>
    </div>
  </div>

  <div id="toast" class="toast hidden" role="status" aria-live="polite" data-testid="swarm-toast"></div>

  <script src="/gif.js"></script>
  <script src="/hive.js"></script>
  <script src="/app.js"></script>
</body>
</html>
